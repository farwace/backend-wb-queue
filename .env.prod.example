# ----------------------------------------------------------------------------
# PRODUCTION environment for wb-alex (backend-wb-queue) — domain: rwb.h1n.ru
# Copy to `.env` on the server, then fill in real secrets:  cp .env.prod.example .env
# Generate a fresh key:  docker compose -f docker-compose.prod.yml run --rm app php artisan key:generate --show
# ----------------------------------------------------------------------------

APP_NAME="WB Queue"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://rwb.h1n.ru

# Trust the host nginx proxy (X-Forwarded-*). "*" = trust the direct proxy.
TRUSTED_PROXIES=*

APP_LOCALE=ru
APP_FALLBACK_LOCALE=ru
APP_FAKER_LOCALE=ru_RU
APP_TIMEZONE=Europe/Moscow

APP_MAINTENANCE_DRIVER=file
APP_PASSWORD_REQUIRED=true

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# --- Database (PostgreSQL service "pgsql" from docker-compose.prod.yml) ---
DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=rwb
DB_USERNAME=rwb
DB_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD

# --- In prod keep sessions & cache in Redis (fast, survives php-fpm restarts) ---
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=rwb.h1n.ru
SESSION_SECURE_COOKIE=true

CACHE_STORE=redis

# --- Queue & broadcasting ---
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=reverb
# Use "local" (uploads under storage/app) or "s3" (Yandex Object Storage bucket)
FILESYSTEM_DISK=local

# --- Redis service "redis" ---
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

# --- Reverb (WebSocket) ---
# REVERB_HOST/PORT/SCHEME describe the PUBLIC address browsers connect to
# (through the host nginx over wss://). REVERB_SERVER_* is where the container binds.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=rwb.h1n.ru
REVERB_PORT=443
REVERB_SCHEME=https
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# --- Yandex Object Storage (S3-compatible), used for incident photo uploads ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ru-central1
AWS_BUCKET=wbjob-storage
AWS_ENDPOINT=https://storage.yandexcloud.net
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Mail ---
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@rwb.h1n.ru"
MAIL_FROM_NAME="${APP_NAME}"

# --- docker-compose.prod.yml host binding (localhost only) ---
APP_PORT=8088
